{%- extends '@App/Layouts/application.html.twig' -%}

{%- if isReset -%}
    {%- set domain = 'password-reset' -%}
{%- else -%}
    {% set domain = 'password-set' -%}
{%- endif -%}

{%- block htmlTitle -%}{{ 'page.htmlTitle' | trans({}, domain) }}{%- endblock -%}
{%- block pageTitle -%}{{ 'pageTitle' | trans({}, domain) }}{%- endblock -%}

{%- block pageContent -%}
    <twig:OPG:Account:Password form="{{ form }}" isReset="{{ isReset }}"/>
{%- endblock -%}
