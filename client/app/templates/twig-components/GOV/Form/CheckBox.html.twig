{%- props id, name, value, checked, label, required=false, disabled=false, legend=null, hint=null, errors=null -%}

{% set hasError = errors is not null %}
{% set hasHint = hint is not null %}

<twig:GOV:Form:FormGroup
    id="{{ id }}"
    legend="{{ legend }}"
    hasHint="{{ hasHint }}"
    hasError="{{ hasError }}"
>
    {% if hasHint %}
        <twig:GOV:Form:Hint hint="{{ hint }}" id="{{ id }}"/>
    {% endif %}
    {% if hasError %}
        <twig:GOV:ErrorMessage message="{{ errors }}"/>
    {% endif %}
    <div class="govuk-checkboxes" data-module="govuk-checkboxes">
        <div class="govuk-checkboxes__item">
            <input
                class="govuk-checkboxes__input"
                id="{{ id }}"
                name="{{ name }}"
                type="checkbox"
                value="{{ value }}"
                {% if checked %}checked{% endif %}
            >
            <label class="govuk-label govuk-checkboxes__label" for="{{ id }}">
                {{- label -}}
            </label>
        </div>
    </div>
</twig:GOV:Form:FormGroup>{#--#}
