{%- props id, label, required=false -%}

{%- if required -%}
    {% set text = label.text %}
{% else %}
    {%- set text = label.text ~ ' ' ~ ('gov.form.label.optional'|trans({}, 'twig-components')) -%}
{% endif %}

{%- if label.h is not null -%}
    {%- set h_tag = "h" ~ label.h -%}
    <{{ h_tag }} class="govuk-label-wrapper">
        <label class="govuk-label govuk-label--{{ label.size }}" for="{{ id }}">
            {{- text -}}
        </label>
    </{{ h_tag }}>
{%- else -%}
    <label class="govuk-label" for="{{ id }}">
        {{- text -}}
    </label>
{%- endif -%}
