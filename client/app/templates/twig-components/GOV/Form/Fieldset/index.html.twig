{%- props id, hasError=false, hasHint=false, legend, h=null, size='m' -%}

<fieldset
    class="govuk-fieldset"
    {%- if hasError or hasHint -%}
        aria-describedby="{% if hasHint %}{{ id }}-hint {% endif %}{% if hasError %}{{ id }}-error{% endif %}"
    {%- endif -%}
>
    <twig:GOV:Form:Fieldset:Legend legend="{{ legend }}" h="{{ h }}" size="{{ size }}"/>
</fieldset>
