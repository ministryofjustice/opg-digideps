{% props element %}
<div class="govuk-form-group">
    {% set label = element.vars.label %}
    {% if not element.vars.required %}
        {% set label = (label | trans({}, 'twig-components')) ~ ' ' ~ ('opg.optional' | trans({}, 'twig-components')) %}
    {% endif %}
    {{ form_label(element, label, { label_attr: { class: "govuk-label govuk-label" } }) }}
    {{ form_errors(element) }}
    {{ form_help(element, { help_attr: { class: "govuk-hint" } }) }}
    {{ form_widget(element, { attr: { class: "govuk-input govuk-!-width-one-half" } }) }}
</div>
