{% props size="m", noMargin=false %}
{% set className = "govuk-body" %}
{% if size != "m" %}
    {% set className = className ~ '-' ~ size %}
{% endif %}
{% if noMargin %}
    {% set className = className ~ ' govuk-!-margin-0' %}
{% endif %}

<p {{ attributes.defaults({class: className}) }}>
    {% with outerScope %}
    {% block content %}{% endblock %}
    {% endwith %}
</p>
