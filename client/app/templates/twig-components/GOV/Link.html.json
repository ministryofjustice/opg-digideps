{
    "link": "https://design-system.service.gov.uk/styles/links/",
    "props": [
        { "name": "href", "type": "string" },
        { "name": "noVisitedState", "type": "bool", "default": "false" },
        { "name": "inverse", "type": "bool", "default": "false" },
        { "name": "inNewTab", "type": "bool", "default": "false" },
        { "name": "accessibilityText", "type": "string", "default": null },
        { "name": "text", "type": "string", "default": null },
