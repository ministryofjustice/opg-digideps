{% props account %}

{% if account.bankName %}<twig:GOV:Paragraph size="m" noMargin>
    {{ account.bankName }}
</twig:GOV:Paragraph>{% endif %}
<twig:GOV:Paragraph size="s" noMargin>
    {{ account.type }}
</twig:GOV:Paragraph>
{% if account.sortCode %}<twig:GOV:Paragraph size="s" noMargin>
    {{ 'opg.renderable.bankAccount.sortCode'|trans({}, 'twig-components') }}: {{ account.sortCode }}
</twig:GOV:Paragraph>{% endif %}
<twig:GOV:Paragraph size="s" noMargin>
    {{ 'opg.renderable.bankAccount.number'|trans({}, 'twig-components') }}: ****{{ account.number }}
</twig:GOV:Paragraph>
<twig:GOV:Paragraph size="s" noMargin>
    {{ 'opg.renderable.bankAccount.joint'|trans({}, 'twig-components') }}: {{ (account.joint ? 'yes' : 'no')|trans({}, 'common') }}
</twig:GOV:Paragraph>
<twig:GOV:Paragraph size="s" noMargin>
    {{ 'opg.renderable.bankAccount.closed'|trans({}, 'twig-components') }}: {{ (account.closed ? 'yes' : 'no')|trans({}, 'common') }}
</twig:GOV:Paragraph>
