{%- if props.accountCreated -%}
    <twig:GOV:Heading h="2" s="m">{{ text.accountCreatedSubHeading }}</twig:GOV:Heading>{#--#}

    <twig:GOV:Paragraph>
        {{ text.linkSentTo }} <strong>{{ text.deputyEmail }}</strong> {{ text.activationReminder }}
    </twig:GOV:Paragraph>{#--#}

    <twig:GOV:Paragraph>{{ text.expirationNote }}</twig:GOV:Paragraph>{#--#}

    <twig:GOV:Paragraph>{{ text.checkJunk }}</twig:GOV:Paragraph>{#--#}

    <twig:GOV:Paragraph>
        <twig:GOV:Link href="{{ path(props.loginPath) }}">{{ text.signInCaps }}</twig:GOV:Link>
    </twig:GOV:Paragraph>
{%- else -%}
    <twig:GOV:Layout:Row>
        <twig:GOV:Layout:Column n="2" d="3">
            <twig:GOV:Paragraph>{{ text.intro }}</twig:GOV:Paragraph>{#--#}

            <twig:GOV:Paragraph>
                {{ text.ifYouAlreadyHaveAnAccount }} <twig:GOV:Link href="{{ path(props.loginPath) }}">{{ text.signIn }}</twig:GOV:Link>.
            </twig:GOV:Paragraph>

            <twig:Render self="{{ form }}"/>
        </twig:GOV:Layout:Column>
    </twig:GOV:Layout:Row>{#--#}
{%- endif -%}
