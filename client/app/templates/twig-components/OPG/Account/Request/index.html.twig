{% if accountCreationFailed %}
    <twig:GOV:Paragraph>{{ text.accountCreationErrorMessage }}</twig:GOV:Paragraph>
{% elseif accountCreated %}
    <twig:GOV:Heading h="2" s="m">{{ text.accountCreatedSubHeading }}</twig:GOV:Heading>

    <twig:GOV:Paragraph>
        {{ text.linkSentTo }} <strong>{{ deputyEmail }}</strong> {{ text.activationReminder }}
    </twig:GOV:Paragraph>

    <twig:GOV:Paragraph>{{ text.expirationNote }}</twig:GOV:Paragraph>

    <twig:GOV:Paragraph>{{ text.checkJunk }}</twig:GOV:Paragraph>

    <twig:GOV:Paragraph>
        <twig:GOV:Link href="{{ path(loginPath) }}">{{ text.signInCaps }}</twig:GOV:Link>
    </twig:GOV:Paragraph>
{% else %}
    <twig:GOV:Paragraph>{{ text.intro }}</twig:GOV:Paragraph>

    <twig:GOV:Paragraph>
        {{ text.ifYouAlreadyHaveAnAccount }} <twig:GOV:Link href="{{ path(loginPath) }}">{{ text.signIn }}</twig:GOV:Link>.
    </twig:GOV:Paragraph>

    <twig:GOV:Form form="{{ form }}">
        <twig:GOV:Form:TextInput element="{{ form.deputyFirstName }}"/>
        <twig:GOV:Form:TextInput element="{{ form.deputyLastName }}"/>
        <twig:GOV:Form:TextInput element="{{ form.deputyEmail.first }}"/>
        <twig:GOV:Form:TextInput element="{{ form.deputyEmail.second }}"/>
        <twig:GOV:Form:TextInput element="{{ form.deputyPostCode }}"/>
        <twig:GOV:Form:TextInput element="{{ form.clientLastName }}"/>
        <twig:GOV:Form:TextInput element="{{ form.caseNumber }}"/>
        <twig:GOV:Form:Submit element="{{ form.signUp }}"/>
    </twig:GOV:Form>
{% endif %}
