<twig:GOV:Heading size="m" h="2">
    {{ text.header }}
</twig:GOV:Heading>

<twig:GOV:Summary:QaCard h="3" list="{{ list }}"/>

{% if feesAndExpensesTable is not null %}
    <twig:GOV:Summary:Card h="3" header="{{ text.feesAndExpensesHeader }}">
        <twig:GOV:Table table="{{ feesAndExpensesTable }}"/>
    </twig:GOV:Summary:Card>
{% endif %}

{% if otherExpensesTable is not null %}
    <twig:GOV:Summary:Card h="3" header="{{ text.otherExpensesHeader }}">
        <twig:GOV:Table table="{{ otherExpensesTable }}"/>
    </twig:GOV:Summary:Card>
{% endif %}
