<twig:GOV:Heading size="l" h="1">
    {{ text.header }}
    Deputy report for {{ reportTypeHeading }} decisions
</twig:GOV:Heading>
<twig:GOV:Heading size="m" h="2">{{ text.infoHeader }}</twig:GOV:Heading>
<twig:GOV:Summary:Card h="2" header="{{ text.reportInformation }}" list="{{ reportInformation }}"/>
<twig:GOV:Summary:Card h="2" header="{{ text.deputyDetails }}">
    {% if deputyDetails is not null %}
        <twig:GOV:Summary:List list="{{ deputyDetails }}"/>
    {% else %}
        <twig:GOV:Warning noMargin>{{ text.noDeputy }}</twig:GOV:Warning>
    {% endif %}
</twig:GOV:Summary:Card>

<twig:GOV:Summary:Card h="2" header="{{ text.clientDetails }}" list="{{ clientDetails }}"/>
