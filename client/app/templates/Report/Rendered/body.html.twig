{% set client = report.client %}
{% set transOptions = {'%client%': report.client.firstname | striptags } %}
{% set reportTypeHeading = ('-4' == report.get104TransSuffix) ? 'property and financial, and health and welfare' : ('104' in report.type) ? 'health and welfare' : 'property and financial'  %}
{% set submittedBy = report.submittedBy | default(app.user) %}
{# for PROF users, deputy is always the named deputy #}
{% set deputy = submittedBy.isDeputyOrg and client.getDeputy ? client.getDeputy : submittedBy %}

<div class="report-preview">
    <twig:OPG:Review:ReportHeader report="{{ report }}"/>

    {% if report.hasSection('decisions')  %}
        <twig:OPG:Review:Decisions report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('contacts') %}
        <twig:OPG:Review:Contacts report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('visitsCare') %}
        <twig:OPG:Review:VisitsCare report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('clientBenefitsCheck') %}
        <twig:OPG:Review:ClientBenefitsCheck report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('bankAccounts')%}
        <twig:OPG:Review:BankAccounts report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('deputyExpenses') %}
        <twig:OPG:Review:DeputyExpenses report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('gifts') %}
        <twig:OPG:Review:Gift report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('moneyTransfers') and (report.bankAccounts | length) > 1 %}
        <twig:OPG:Review:MoneyTransfers report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('moneyInShort') %}
        <twig:OPG:Review:MoneyInShort report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('moneyIn') %}
        <twig:OPG:Review:MoneyIn report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('moneyOut') %}
        <twig:OPG:Review:MoneyOut report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('balance') %}
        <twig:OPG:Review:Balance report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('assets') %}
        <twig:OPG:Review:Assets report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('debts') %}
        <twig:OPG:Review:Debts report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('actions') %}
        <twig:OPG:Review:Actions report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('otherInfo') %}
        <twig:OPG:Review:OtherInfo report="{{ report }}"/>
    {% endif %}

    {% if report.hasSection('documents') %}
        <twig:OPG:Review:Documents report="{{ report }}"/>
    {% endif %}
</div>
