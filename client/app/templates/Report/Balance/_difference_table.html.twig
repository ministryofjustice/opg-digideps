{% set translationDomain = "report-balance" %}
{% trans_default_domain translationDomain %}

{% set transOptions = {
    '%client%': report.client.firstname | striptags,
    '%moreless%': report.totalsOffset < 0 ? "less" : "more"
} %}

{% set hideEditLink = hideEditLink | default(false) %}

<h3 class="govuk-heading-m">
    {% if not report.isTotalsMatch %}
        {{ 'differenceTable.headingNotBalanced' | trans }}
    {% else %}
        {{ 'differenceTable.headingBalanced' | trans }}
    {% endif %}
</h3>

<table class="govuk-table govpush--ends" id="calculated_balance_table">
    <thead class="govuk-table__head govuk-visually-hidden">
        <tr class="govuk-table__row">
            <th>{{ 'section' | trans({}, 'common') }}</th>
            <th colspan="2"></th>
            <th scope="col" class="govuk-table__header govuk-table__header--numeric">{{ 'balance' | trans({}, 'common') }}</th>
            {% if not hideEditLink  %}
                <th class="govuk-table__header govuk-table__header--numeric">
                    <span class="govuk-visually-hidden">{{ 'actions' | trans({}, 'common') }}</span>
                </th>
            {% endif %}
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">{{ 'differenceTable.accountsClosingBalance' | trans }}
                ({{ report.endDate | date("j F Y") }})
            </td>
            <td class="govuk-table__cell" colspan="2"></td>
            <td class="govuk-table__cell govuk-table__cell--numeric">
                £{{ report.accountsClosingBalanceTotal | money_format }}
            </td>
            {% if not hideEditLink  %}
                <td class="govuk-table__cell govuk-table__cell--numeric width-twentieth">
                    <a href="{{ path('bank_accounts', {'reportId': report.id}) }}" class="govuk-!-font-weight-bold">
                        {{ 'edit' | trans({}, 'common') }}
                        <span class="govuk-visually-hidden">{{ 'differenceTable.accountsClosingBalance' | trans }}</span>
                    </a>
                </td>
            {% endif %}
        </tr>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell">{{ 'differenceTable.reportClosingBalance' | trans }}</td>
            <td class="govuk-table__cell" colspan="2"></td>
            <td class="govuk-table__cell govuk-table__cell--numeric">
                £{{ report.calculatedBalance | money_format }}
            </td>
            {% if not hideEditLink  %}
                <td class="govuk-table__cell govuk-table__cell--numeric"></td>
            {% endif %}
        </tr>
    </tbody>
    <tfoot>
        <tr class="govuk-table__row">
            <td class="govuk-table__cell" colspan="3">
                <span class="govuk-!-font-weight-bold">{{ 'differenceTable.footer' | trans }}</span>
            </td>
            <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">
                    <span class="govuk-!-font-weight-bold behat-region-balance-difference">
                        £{{ report.totalsOffset | abs | money_format }}
                    </span>
            </td>
            {% if not hideEditLink  %}
                <td class="govuk-table__cell govuk-table__cell--numeric"></td>
            {% endif %}
        </tr>
    </tfoot>
</table>
