{% extends '@App/Layouts/application.html.twig' %}

{% block htmlTitle %}{{ 'htmlTitle' | trans({}, 'register') }}{% endblock %}
{% block pageTitle %}{{ 'pageTitle' | trans({}, 'register') }}{% endblock %}

{% block head %}
    {{ parent() }}
    <link href="{{ 'stylesheets/formatted-report.css' | assetUrl }}" rel="stylesheet" type="text/css">
{% endblock %}

{% block pageContent %}
    <twig:GOV:Form form="{{ form }}">
        <twig:GOV:Form:TextInput element="{{ form.firstname }}"/>
    </twig:GOV:Form>
{% endblock %}
