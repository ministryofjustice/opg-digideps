{
    "name": "symfony/framework-standard-edition",
    "license": "MIT",
    "type": "project",
    "description": "The \"Symfony Standard Edition\" distribution",
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "lint:phpstan": "phpstan --memory-limit=512M",
        "lint:phpstan:baseline": "phpstan --memory-limit=512M && phpstan --memory-limit=512M --generate-baseline",
        "lint:phpstan:baseline:force": "phpstan --memory-limit=512M --generate-baseline"
    },
    "autoload": {
        "psr-4": {
            "OPG\\Digideps\\Frontend\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\OPG\\Digideps\\Frontend\\": "tests/"
        }
    },
    "require": {
        "ext-dom": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "alphagov/notifications-php-client": "^7.1.1",
        "aws/aws-sdk-php": "^3.403.2",
        "digideps/common": "^1.0",
        "doctrine/annotations": "^2.0.2",
        "doctrine/collections": "^2.6.0",
        "egulias/email-validator": "^4.0.4",
        "fakerphp/faker": "^1.24.1",
        "guzzlehttp/guzzle": "^7.16.1",
        "jms/serializer-bundle": "^5.5.2",
        "jolicode/slack-php-api": "^4.10",
        "league/mime-type-detection": "^1.17",
        "monolog/monolog": "^3.12.1",
        "orbitale/imagemagick-php": "^3.3.5",
        "php-http/guzzle7-adapter": "^1.1",
        "predis/predis": "^3.7.1",
        "symfony/asset": "^6.4.34",
        "symfony/cache": "^6.4.50",
        "symfony/config": "^6.4.50",
        "symfony/console": "^6.4.50",
        "symfony/debug-bundle": "^6.4.35",
        "symfony/dependency-injection": "^6.4.49",
        "symfony/dotenv": "^6.4.45",
        "symfony/error-handler": "^6.4.49",
        "symfony/event-dispatcher": "^6.4.44",
        "symfony/expression-language": "^6.4.48",
        "symfony/form": "^6.4.50",
        "symfony/framework-bundle": "^6.4.49",
        "symfony/http-client": "^6.4.50",
        "symfony/http-foundation": "^6.4.50",
        "symfony/http-kernel": "^6.4.50",
        "symfony/intl": "^6.4.49",
        "symfony/lock": "^6.4.50",
        "symfony/mime": "^6.4.49",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/options-resolver": "^6.4.49",
        "symfony/property-info": "^6.4.50",
        "symfony/rate-limiter": "^6.4.50",
        "symfony/routing": "^6.4.50",
        "symfony/security-bundle": "^6.4.50",
        "symfony/security-core": "^6.4.50",
        "symfony/security-csrf": "^6.4.31",
        "symfony/security-http": "^6.4.50",
        "symfony/serializer": "^6.4.50",
        "symfony/translation": "^6.4.50",
        "symfony/twig-bundle": "^6.4.48",
        "symfony/uid": "^6.4.48",
        "symfony/ux-twig-component": "^2.36",
        "symfony/validator": "^6.4.50",
        "symfony/web-profiler-bundle": "^6.4.50",
        "twig/extra-bundle": "^3.29",
        "twig/html-extra": "^3.29",
        "twig/intl-extra": "^3.30",
        "twig/twig": "^3.30",
        "web-token/jwt-framework": "^3.4.13"
    },
    "require-dev": {
        "ext-fileinfo": "*",
        "dg/bypass-finals": "^1.11.1",
        "league/openapi-psr7-validator": "^0.24.0",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpunit/phpcov": "^13.2.1",
        "phpunit/phpunit": "^13.4.6",
        "symfony/maker-bundle": "^1.67.0",
        "symfony/phpunit-bridge": "^6.4.49",
        "symfony/var-dumper": "^6.4.49"
    },
    "extra": {
        "symfony-app-dir": "app",
        "branch-alias": {
            "dev-master": "2.3-dev"
        },
        "symfony": {
            "require": "6.*"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../common",
            "options": {
                "versions": {
                    "digideps/common": "1.0.0"
                }
            }
        }
    ]
}
